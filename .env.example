# Copy to .env (never commit .env) and fill in real values.

# --- Backend ---
# Comma-separated Gemini API keys. At least 2 are needed to see failover.
# Get keys at https://aistudio.google.com/apikey (use two different Google projects).
LLM_API_KEYS=PUT_KEY_1_HERE,PUT_KEY_2_HERE
LLM_MODEL=gemini/gemini-2.0-flash
# Docker / Render: sqlite:////data/app.db   Local without Docker: sqlite:///./app.db
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true

# --- Frontend (build-time, embedded into the JS bundle) ---
VITE_API_BASE_URL=http://localhost:8000
